# Application
APP_NAME=Hospital AI API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
# Set to false only if local SSL inspection breaks Supabase HTTPS calls
SUPABASE_SSL_VERIFY=true

# Intake Agent — provider adapters (stub works without API keys)
OCR_PROVIDER=stub
LLM_PROVIDER=stub
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# GOOGLE_VISION_API_KEY=
# AZURE_OCR_ENDPOINT=
# AZURE_OCR_KEY=

# Diagnosis Agent — clinical decision support (assists, never replaces, a physician)
DIAGNOSIS_ENGINE=rule_based

# Research Agent — evidence enrichment providers (mock works without API keys)
RESEARCH_PROVIDER=mock
# PUBMED_API_KEY=
# CLINICAL_TRIALS_API_KEY=
