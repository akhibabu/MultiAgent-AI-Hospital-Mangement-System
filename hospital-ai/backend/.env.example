# Application
APP_NAME=Hospital AI API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
# Set to false only if local SSL inspection breaks Supabase HTTPS calls
SUPABASE_SSL_VERIFY=true

# Intake Agent — OCR provider only (stub works without API keys).
# LLM enrichment for Intake now goes through the AI Orchestrator below.
OCR_PROVIDER=stub
# GOOGLE_VISION_API_KEY=
# AZURE_OCR_ENDPOINT=
# AZURE_OCR_KEY=

# =============================================================================
# AI Orchestrator — single entry point for every AI/LLM request.
#
#   AI Agent -> AI Orchestrator -> Provider Orchestrator -> Provider Router
#            -> Provider Health Monitor -> Groq / Gemini / OpenRouter / HF
#
# No AI Agent talks to a provider directly. The provider *fleet* (priority,
# models, capabilities, pricing) is declared in backend/providers.yaml; this
# file only holds the credentials that file reads.
#
# FAILOVER: if a provider hits its quota, rate limits, or goes down, the
# system automatically switches to the next configured provider. Set more
# than one key below — that is what keeps the system available. All four
# primary providers have a free tier.
# =============================================================================

# Preferred primary provider. This is a PREFERENCE, not a lock: if it is
# unavailable the system automatically fails over to the next provider.
#   groq | gemini | openrouter | huggingface | openai | anthropic | ollama | stub
# `stub` is the one exception — it pins the system fully offline for tests.
AI_PROVIDER=groq

# --- 1. Groq (priority 1) — free key: https://console.groq.com/keys ----------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- 2. Google Gemini (priority 2) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- 3. OpenRouter (priority 3) — free key: https://openrouter.ai/keys -------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-r1-0528:free

# --- 4. HuggingFace (priority 4) — free token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Model Router — which model each agent uses on the PRIMARY provider.
# Fallback providers use their own model from providers.yaml.
# See https://console.groq.com/docs/models for current Groq model IDs.
INTAKE_MODEL=llama-3.3-70b-versatile
DIAGNOSIS_MODEL=llama-3.3-70b-versatile
RESEARCH_MODEL=llama-3.3-70b-versatile
PRESCRIPTION_MODEL=llama-3.3-70b-versatile
REPORT_MODEL=llama-3.3-70b-versatile

# Generation defaults
TEMPERATURE=0.2

# Completion reservation per call. NOTE: providers meter `prompt + MAX_TOKENS`
# against ONE limit, so this is subtracted from your prompt budget whether or
# not the model uses it. On Groq's free tier (5 800 tokens/request) a value of
# 4096 leaves only ~1 700 tokens for the prompt, which is how a long patient
# context turns into "HTTP 413 request too large".
# Agent responses are structured JSON and observed at 200-700 tokens, so 2048
# is generous while leaving ~3 700 tokens of prompt room.
# The orchestrator shrinks this automatically when it won't fit, but starting
# lower means it rarely has to.
MAX_TOKENS=2048

# Per-request network timeout in seconds (applies to every provider)
TIMEOUT=120

# Load balancer strategy: priority | round_robin | least_latency | least_errors
# round_robin spreads load across providers and stretches free-tier quotas.
AI_LOAD_BALANCER_STRATEGY=priority
# Master switch for automatic failover (false = single-provider behavior)
AI_FAILOVER_ENABLED=true

# Provider Health Monitor — circuit breaker thresholds
AI_HEALTH_FAILURE_THRESHOLD=3
AI_HEALTH_COOLDOWN_SECONDS=120
# Daily/monthly quota exhaustion doesn't recover in minutes — skip for longer.
AI_HEALTH_QUOTA_COOLDOWN_SECONDS=900

# Cache Manager (in-memory TTL cache of identical requests).
# Per-agent TTLs are multiplied off this base — research caches longest,
# prescription shortest (a stale drug-interaction check must never be served).
AI_CACHE_TTL_SECONDS=300

# Retry Handler (exponential backoff on timeouts/connection/rate-limit errors)
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_MS=500

# Conversation Memory — recent turns included per orchestrator call
AI_MEMORY_TURNS=5

# Token optimization — compress patient context before each provider call.
# Biggest single saving: drops replayed prompt text from conversation memory.
AI_CONTEXT_COMPRESSION=true

# Request Queue — bounds simultaneous provider calls so a burst of agent runs
# queues instead of stampeding a provider's concurrency limit.
AI_MAX_CONCURRENT_REQUESTS=4
AI_QUEUE_WAIT_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Additional providers — implemented and pluggable. Enable them in
# providers.yaml (`openai.enabled: true`, etc.) once a key is set here.
# No AI Agent or orchestrator code changes when you do.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=

# Ollama — local runtime, no API key or quota. Requires `ollama serve` with the
# model pulled: ollama pull llama3.1:8b   Then set OLLAMA_ENABLED=true.
OLLAMA_URL=http://localhost:11434
# OLLAMA_ENABLED=true

# Reserved for a future live PubMed / ClinicalTrials.gov integration —
# the Research Agent's LLM-backed providers do not call these yet.
# PUBMED_API_KEY=
# CLINICAL_TRIALS_API_KEY=
